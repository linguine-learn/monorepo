cabal-version:      3.14
name:               linguine
version:            0.1.0.0
-- synopsis:
-- description:
-- homepage:
license:            MIT
license-file:       LICENSE
author:             p-febis
maintainer:         n
-- copyright:
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Linguine.Server,

                      Linguine.Auth.Register,
                      Linguine.Auth.Login,
                      Linguine.Auth.Refresh,
                      Linguine.Auth.JWT,

                      Linguine.DB.Models,
                      Linguine.DB.Queries,
                      Linguine.DB.Mutations
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.20.0.0,
                      servant-server,
                      wai,
                      warp,
                      aeson,
                      postgresql-simple,
                      resource-pool,
                      bytestring,
                      dotenv,
                      password,
                      text,
                      jwt,
                      containers,
                      time,
                      cookie

    hs-source-dirs:   src
    default-language: GHC2024

executable linguine
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.0.0,
        linguine

    hs-source-dirs:   app
    default-language: GHC2024

test-suite linguine-test
    import:           warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.0.0,
        linguine
