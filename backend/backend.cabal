cabal-version:      3.12
name:               backend
version:            0.1.0.0
-- synopsis:
-- description:
author:             p-febis
maintainer:         n
-- copyright:
category:           Web
build-type:         Simple
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Linguine.Server,
                      Linguine.Config,
                      Linguine.Auth.OAuth,
                      Linguine.Auth.OAuth.Google,
                      Linguine.Auth.EmailPassword.Register,

                      Linguine.Models.Session,
                      Linguine.Models.User
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.20.0.0,
                      scotty,
                      uuid,
                      time,
                      postgresql-simple,
                      resource-pool,
                      hoauth2,
                      dotenv,
                      text,
                      uri-bytestring,
                      bytestring,
                      utf8-string,
                      http-types,
                      http-client,
                      http-conduit,
                      cookie,
                      mtl,
                      jwt,
                      containers,
                      aeson

    hs-source-dirs:   src
    default-extensions: OverloadedStrings
                        DeriveAnyClass
    default-language: GHC2024

executable backend
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.0.0,
        backend

    hs-source-dirs:   app
    default-language: GHC2024

test-suite backend-test
    import:           warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.0.0,
        backend
